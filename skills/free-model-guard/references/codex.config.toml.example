# Codex 配置: 走本地 litellm 网关 (免费模型, 不弹 ChatGPT 登录)
# 官方自定义 provider 写法: model_providers.<name> + wire_api="responses"
model = "gpt-5.2"
model_provider = "litellm"
model_reasoning_effort = "medium"

[model_providers.litellm]
name = "Local LiteLLM (free models)"
base_url = "http://127.0.0.1:4101/v1"   # codex-tool-filter: 剥离 namespace tool -> litellm:4100
env_key = "OPENAI_API_KEY"               # 占位, litellm 网关免auth
wire_api = "responses"                  # Codex 用 /v1/responses 协议, litellm 原生支持

[projects."/home/ubuntu"]
trust_level = "trusted"

[tui.model_availability_nux]
"gpt-5.6-sol" = 1
